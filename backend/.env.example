# Copy to .env / export in your shell. Defaults work for the local demo.

# Storage (SQLite file; created on first run, seeded from the frontend seed)
DATABASE_PATH=backend/data/passports.db
SEED_FILE=frontend/src/data/records.json

# BTU issuer identity + Ed25519 signing key (auto-generated if missing)
ISSUER_NAME=Business and Technology University (BTU)
ISSUER_DID=did:web:btu.edu.ge
ISSUER_WALLET_ADDRESS=0xB7U0000000000000000000000000000000A15C
ISSUER_KEY_FILE=backend/data/issuer_key.pem

# Blockchain anchoring: simulated (offline, deterministic) | web3 (real EVM)
ANCHOR_MODE=simulated
ANCHOR_NETWORK=Polygon Amoy (testnet)
# WEB3_RPC_URL=https://rpc-amoy.polygon.technology
# WEB3_PRIVATE_KEY=

# Sheet source: seed (local JSON) | xlsx (test workbook) | google (live Sheet)
SHEET_SOURCE=seed
SHEET_WRITEBACK=false
# XLSX_PATH=BTU AI Skills Digital Passport Hackathon_Test Data.xlsx
# GOOGLE_SPREADSHEET_ID=
# GOOGLE_CREDENTIALS_FILE=backend/google-service-account.json
# GOOGLE_SHEET_RANGE=Passport Skill Records!A4:T

# Auth — set ADMIN_API_KEY + a real APP_SECRET outside local demos!
ADMIN_API_KEY=
APP_SECRET=dev-only-change-me
TOKEN_TTL_HOURS=12
ALLOW_DEV_EMAIL_AUTH=true
ALLOW_RESET=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
