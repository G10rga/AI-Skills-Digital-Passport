[Unit]
Description=AI Passport backend (FastAPI/uvicorn)
After=network-online.target

[Service]
Type=simple
User=aipassport
Group=aipassport
WorkingDirectory=/opt/aipassport
EnvironmentFile=/opt/aipassport/.env
# Cloudflared already occupies 8000/8001 on this host — bind loopback only.
# HOST/PORT come from /opt/aipassport/.env (127.0.0.1:8013).
ExecStart=/opt/aipassport/.venv/bin/python backend/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
