[Unit]
Description=AI Passport frontend (Nitro node server)
After=network-online.target aipassport-api.service
Wants=aipassport-api.service

[Service]
Type=simple
User=aipassport
Group=aipassport
WorkingDirectory=/opt/aipassport/frontend
Environment=HOST=127.0.0.1
Environment=PORT=8014
ExecStart=/usr/bin/node .output/server/index.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
