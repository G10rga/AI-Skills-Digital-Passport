# Lives at /opt/aipassport/.env on the server (mode 600, never committed).
# setup-ubuntu.sh generates this automatically on first run.

HOST=127.0.0.1
PORT=8013

# Self-hosted PostgreSQL on this server (created by setup-ubuntu.sh).
# Unset = fall back to the SQLite file backend/data/passports.db.
DATABASE_URL=postgresql://aipassport:CHANGE_ME@127.0.0.1:5432/aipassport

ADMIN_API_KEY=CHANGE_ME
APP_SECRET=CHANGE_ME_TOO
ALLOW_RESET=false
ALLOW_DEV_EMAIL_AUTH=true

CORS_ORIGINS=https://aipassport.g1orga.dev

SHEET_SOURCE=seed
ANCHOR_MODE=simulated
