# Copy to deploy/.env.production on the server and fill in real secrets.
# This file is loaded by aipassport-api.service (EnvironmentFile).

HOST=127.0.0.1
PORT=8000

# REQUIRED in production — generate with: openssl rand -hex 32
# Without ADMIN_API_KEY anyone can call /passports, /records, /sync.
ADMIN_API_KEY=CHANGE_ME
APP_SECRET=CHANGE_ME_TOO
ALLOW_RESET=false
ALLOW_DEV_EMAIL_AUTH=true

CORS_ORIGINS=https://aipassport.g1orga.dev,http://localhost:8080

SHEET_SOURCE=seed
ANCHOR_MODE=simulated
